@page "/journal"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Field notes | Lakbay</PageTitle>

@{
    var visible = VisibleNotes;
}

<section class="wrap page-lead">
    <p class="eyebrow kicker text-sun">The journal / People, places, little things</p>
    <h1 class="display-small">Bring home <em>stories.</em></h1>
    <div class="lead-grid">
        <p class="lede">The best souvenirs are the stories you get to tell. Here are a few notes from the places that keep us curious.</p>
        <div class="lead-facts">
            <div><span class="num">@Ui.Pad(SampleData.Notes.Count)</span><span class="eyebrow">Notes</span></div>
            <div><span class="num">@(SampleData.Notes.Sum(n => n.ReadMinutes))</span><span class="eyebrow">Minutes of reading</span></div>
        </div>
    </div>
</section>

<section class="wrap pt-12">
    @* ---------- Editor's pick ---------- *@
    @if (leadNote is not null)
    {
        <div class="journal-lead">
            <button type="button" class="image-frame block w-full" aria-label="Read: @leadNote.Title" @onclick="() => OpenNote(leadNote.Id)">
                <img class="place-image" src="@leadNote.ImagePath" alt="@leadNote.ImageAlt" loading="lazy" />
                <span class="sticker absolute left-4 top-4">Editor's pick</span>
            </button>
            <div>
                <p class="eyebrow kicker text-sun">A slower way to see</p>
                <h2 class="section-title mt-5">Take the scenic route. <em>Then take another.</em></h2>
                <p class="lede mt-5">Travel is not a race between highlights. Stop for the conversations, make room for unexpected discoveries, and let each place surprise you.</p>
                <div class="mt-7 flex flex-wrap gap-4">
                    <button type="button" class="btn-primary" @onclick="() => OpenNote(leadNote.Id)">Read the lead story <span class="arrow" aria-hidden="true">↗</span></button>
                    <a class="btn-outline" href="/discover">Find a place to wander</a>
                </div>
            </div>
        </div>
    }

    @* ---------- Notebook ---------- *@
    <div class="mt-14 flex flex-wrap items-end justify-between gap-5">
        <h2 class="section-title">From the <em>notebook</em></h2>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter journal categories">
            <button type="button" class="chip" aria-pressed="@Ui.Bool(category is null)" @onclick="() => category = null">
                All notes <span class="count">@SampleData.Notes.Count</span>
            </button>
            @foreach (var cat in Enum.GetValues<NoteCategory>())
            {
                var count = SampleData.Notes.Count(n => n.Category == cat);
                if (count == 0) continue;
                <button type="button" class="chip" aria-pressed="@Ui.Bool(category == cat)" @onclick="() => category = cat">
                    @TravelLabels.Label(cat) <span class="count">@count</span>
                </button>
            }
        </div>
    </div>

    @if (visible.Count == 0)
    {
        <div class="empty-state mt-8" role="status">
            <h2 class="section-title">No notes here <em>yet.</em></h2>
            <button type="button" class="btn-primary mt-3" @onclick="() => category = null">All field notes</button>
        </div>
    }
    else
    {
        <div class="journal-grid mt-8">
            @for (var i = 0; i < visible.Count; i++)
            {
                var note = visible[i];
                <article class="note-card" style="--i:@i" @key="note.Id">
                    <div class="min-w-0">
                        <p class="eyebrow text-sun">@note.CategoryLabel <span class="muted">/ <span class="num">@note.ReadMinutes</span> min read</span></p>
                        <h2 class="mt-3">@note.Title</h2>
                        <p class="muted mt-3 text-sm leading-7">@note.Excerpt</p>
                        <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-1">
                            <button type="button" class="link-arrow" @onclick="() => OpenNote(note.Id)">Read story <span class="arrow" aria-hidden="true">↗</span></button>
                            <span class="eyebrow muted">@(SampleData.FindDestination(note.DestinationId)?.Name)</span>
                        </div>
                    </div>
                    <img class="thumb" src="@note.ImagePath" alt="@note.ImageAlt" loading="lazy" />
                </article>
            }
        </div>
    }
</section>

<section class="wrap mt-16 border-t border-line pt-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
            <p class="eyebrow kicker text-sun">Leave room for something unexpected</p>
            <h2 class="section-title mt-5">Your next chapter <em>starts somewhere.</em></h2>
        </div>
        <div class="flex flex-col items-start gap-6">
            <p class="lede">Choose a place, pencil in the dates and start dreaming. You don't need a complicated plan to make a wonderful trip.</p>
            <a href="/plan" class="btn-sun">Sketch a trip <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
    </div>
</section>

@* ============================== READER ============================== *@
@if (Reading is { } story)
{
    var nav = visible.Any(n => n.Id == story.Id) ? visible : SampleData.Notes.ToList();
    var at = nav.FindIndex(n => n.Id == story.Id);
    var place = SampleData.FindDestination(story.DestinationId);

    <div class="backdrop" @onclick="CloseNote"></div>
    <article id="note-reader" class="reader" role="dialog" aria-modal="true" aria-labelledby="reader-title" tabindex="-1" @onkeydown="OnReaderKey">
        <div class="overlay-bar">
            <span class="eyebrow muted">Note <span class="num">@Ui.Pad(at + 1)</span> / <span class="num">@Ui.Pad(nav.Count)</span></span>
            <div class="flex gap-2">
                <button type="button" class="icon-button" aria-label="Previous note" disabled="@(nav.Count < 2)" @onclick="() => OpenNote(nav[(at - 1 + nav.Count) % nav.Count].Id)">←</button>
                <button type="button" class="icon-button" aria-label="Next note" disabled="@(nav.Count < 2)" @onclick="() => OpenNote(nav[(at + 1) % nav.Count].Id)">→</button>
                <button type="button" class="icon-button" aria-label="Close story" @onclick="CloseNote">✕</button>
            </div>
        </div>
        <div class="image-frame" @key="story.Id">
            <img class="place-image" src="@story.ImagePath" alt="@story.ImageAlt" />
        </div>
        <div class="reader-body">
            <p class="eyebrow text-sun">@story.CategoryLabel / <span class="num">@story.ReadMinutes</span> min read</p>
            <h2 id="reader-title" class="section-title mt-4">@story.Title</h2>
            <p class="lede mt-4">@story.Excerpt</p>
            <hr class="rule my-8 border-0" />
            <p class="story">@story.Story</p>
            <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
                <span class="eyebrow muted">Filed from @place?.Name, @place?.Province</span>
                @if (place is not null)
                {
                    <a href="@($"/plan?place={place.Id}")" class="btn-sun">Plan @place.Name <span class="arrow" aria-hidden="true">↗</span></a>
                }
            </div>
        </div>
    </article>
}

@code {
    private readonly FieldNote? leadNote = SampleData.FindNote(4) ?? SampleData.Notes.FirstOrDefault();
    private NoteCategory? category;
    private int? readingId;
    private bool focusReader;

    private List<FieldNote> VisibleNotes => category is null
        ? SampleData.Notes.ToList()
        : SampleData.Notes.Where(n => n.Category == category).ToList();

    private FieldNote? Reading => readingId is int id ? SampleData.FindNote(id) : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusReader) return;
        focusReader = false;
        try { await JS.InvokeVoidAsync("lakbay.openOverlay", "note-reader"); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private void OpenNote(int id)
    {
        readingId = id;
        focusReader = true;
    }

    private async Task CloseNote()
    {
        readingId = null;
        try { await JS.InvokeVoidAsync("lakbay.closeOverlay"); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private async Task OnReaderKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { await CloseNote(); return; }
        if (e.Key is not ("ArrowRight" or "ArrowLeft") || readingId is null) return;

        var nav = VisibleNotes.Any(n => n.Id == readingId) ? VisibleNotes : SampleData.Notes.ToList();
        var at = nav.FindIndex(n => n.Id == readingId);
        OpenNote(nav[e.Key == "ArrowRight" ? (at + 1) % nav.Count : (at - 1 + nav.Count) % nav.Count].Id);
    }
}
